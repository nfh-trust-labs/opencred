# =============================================================================
# OpenCred Server — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
#
# SECURITY: Never commit .env files containing real secrets. This file
# contains only placeholder values and is safe to commit.
# =============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the HTTP server listens on (default: 3100).
OPENCRED_PORT=3100

# Bearer token for API authentication. REQUIRED for protected endpoints
# unless OPENCRED_DEV_MODE_NO_AUTH=true is set.
# Generate a strong random token: openssl rand -hex 32
OPENCRED_API_KEY=

# Explicit opt-out for authentication — local development only.
# When true, protected endpoints are reachable without an API key.
# REFUSED when NODE_ENV=production. Mutually exclusive with OPENCRED_API_KEY.
OPENCRED_DEV_MODE_NO_AUTH=false

# Log level for pino (fatal | error | warn | info | debug | trace).
OPENCRED_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Signing key (file-based)
# ---------------------------------------------------------------------------

# Path to the signing key file (PEM, JWK, PKCS#8, or PFX).
# If unset, signing will be unavailable and the health endpoint returns 503.
OPENCRED_KEY_PATH=

# Password for PFX key files (leave blank for PEM/JWK).
OPENCRED_KEY_PASSWORD=

# Human-readable label for the signing key (displayed in metadata).
OPENCRED_KEY_LABEL=server-key

# ---------------------------------------------------------------------------
# Batch issuance
# ---------------------------------------------------------------------------

# Maximum rows allowed in a single batch CSV (default: 1000).
OPENCRED_BATCH_ROW_LIMIT=1000

# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

# Session TTL in seconds for ephemeral credential data (default: 14400 = 4h).
OPENCRED_SESSION_TTL=14400

# ---------------------------------------------------------------------------
# Cloud HSM (KMS) — alternative to file-based signing
# ---------------------------------------------------------------------------

# KMS provider: aws | azure | gcp | none (default: none = file-based).
OPENCRED_KMS_PROVIDER=none

# AWS KMS key ARN (required when OPENCRED_KMS_PROVIDER=aws).
OPENCRED_KMS_KEY_ARN=

# Azure Key Vault URL (required when OPENCRED_KMS_PROVIDER=azure).
OPENCRED_AZURE_KEY_VAULT_URL=

# Azure Key Vault key name (required when OPENCRED_KMS_PROVIDER=azure).
OPENCRED_AZURE_KEY_NAME=

# GCP KMS key resource name (required when OPENCRED_KMS_PROVIDER=gcp).
OPENCRED_GCP_KMS_KEY_NAME=

# ---------------------------------------------------------------------------
# Trust store
# ---------------------------------------------------------------------------

# Path to a directory containing PEM/DER-encoded CSCA root certificates
# used as trust anchors when verifying credentials with embedded x5c chains.
# When unset, the verifier fails closed for credentials carrying an x5c chain.
OPENCRED_CSCA_TRUST_STORE_PATH=

# ---------------------------------------------------------------------------
# Schema updates
# ---------------------------------------------------------------------------

# HTTPS URL of the schema update manifest. If unset, schema updates are disabled.
OPENCRED_SCHEMA_UPDATE_URL=

# Local directory for caching updated schemas between restarts.
OPENCRED_SCHEMA_CACHE_DIR=
