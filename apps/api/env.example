# ──────────────────────────────────────────────────────────────
# OpenCred API — Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# Node environment: "development" | "production" | "test"
NODE_ENV=development

# Server port
PORT=3000

# Log level: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL=info

# ── DeDi Integration ──────────────────────────────────────────
# Base URL of the DeDi API (must be HTTPS in production)
# DEDI_API_URL=https://dedi.example.com

# Timeout for DeDi API requests in milliseconds
DEDI_API_TIMEOUT_MS=10000

# Auth type: "api-key" | "bearer"
DEDI_AUTH_TYPE=api-key

# Required when DEDI_AUTH_TYPE=api-key
# DEDI_API_KEY=

# Required when DEDI_AUTH_TYPE=bearer
# DEDI_EMAIL=
# DEDI_PASSWORD=

# Default DeDi namespace for record operations
# DEDI_DEFAULT_NAMESPACE=

# ── Session / State ───────────────────────────────────────────
# TTL for in-memory session data (milliseconds). Default: 4 hours.
SESSION_TTL_MS=14400000

# How often to sweep expired sessions (milliseconds). Default: 60s.
SESSION_SWEEP_INTERVAL_MS=60000

# ── Auth / JWT ────────────────────────────────────────────────
# HMAC secret for signing capability tokens (min 32 characters)
# JWT_SECRET=

# Issuer claim for JWTs
JWT_ISSUER=opencred

# Token expiry in seconds. Default: 1 hour.
JWT_EXPIRY_SECONDS=3600

# ── Batch Processing ─────────────────────────────────────────
# Maximum number of credentials per batch. Default: 1000.
MAX_BATCH_SIZE=1000

# ── CSCA Trust Store ─────────────────────────────────────────
# Path to the CSCA trust store PEM bundle (for Type A DSC onboarding)
# CSCA_TRUST_STORE_PATH=

# ── CORS ──────────────────────────────────────────────────────
# Allowed origin for CORS. Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
