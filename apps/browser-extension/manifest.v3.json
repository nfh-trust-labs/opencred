{
  "manifest_version": 3,
  "name": "OpenCred Signing",
  "description": "OpenCred Native Signing Host bridge — connects web app to local signing keys (PKCS#11, OS certificates, software keys).",
  "version": "0.1.0",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.opencred.example.com/*",
        "http://localhost:5173/*",
        "http://localhost:8080/*"
      ],
      "js": ["dist/content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
