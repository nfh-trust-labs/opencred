# ==============================================================================
# OpenCred Server — Environment Variables
# ==============================================================================
# Copy to .env and configure before running.
# Sensitive values (keys, passwords) are validated but NEVER logged.
# ==============================================================================

# ---------- Server ----------
# Port the HTTP server listens on (default: 3100)
OPENCRED_PORT=3100

# Bearer token for API authentication.
# REQUIRED unless OPENCRED_DEV_MODE_NO_AUTH=true is set.
# The server refuses to start without it (fail-closed).
# Generate with: openssl rand -base64 32
OPENCRED_API_KEY=

# Explicit opt-out of API-key auth for local development only.
# Mutually exclusive with OPENCRED_API_KEY.
# REFUSED when NODE_ENV=production.
# OPENCRED_DEV_MODE_NO_AUTH=true

# Log level: fatal | error | warn | info | debug | trace (default: info)
OPENCRED_LOG_LEVEL=info

# ---------- Signing Key ----------
# Path to the signing key file (PEM, JWK, PKCS#8, or PFX).
# Mounted into the container at runtime — NEVER baked into the image.
OPENCRED_KEY_PATH=

# Password for PFX key files (leave blank for PEM/JWK).
OPENCRED_KEY_PASSWORD=

# Human-readable label for the signing key (default: server-key)
OPENCRED_KEY_LABEL=server-key

# ---------- Batch Issuance ----------
# Maximum rows allowed in a single batch CSV (default: 1000)
OPENCRED_BATCH_ROW_LIMIT=1000

# ---------- Session ----------
# Session TTL in seconds for ephemeral credential data (default: 14400 = 4 hours)
OPENCRED_SESSION_TTL=14400

# ---------- Trust Store ----------
# Path to a directory of PEM-encoded CSCA root certificates.
# Required for verifying credentials with X.509 certificate chains (DSC-backed).
# Mount read-only into the container.
# CSCA_TRUST_STORE_PATH=/app/trust-store

# ---------- Cloud HSM (optional) ----------
# KMS provider: aws | azure | gcp | none (default: none = file-based keys)
# OPENCRED_KMS_PROVIDER=none

# AWS KMS (when OPENCRED_KMS_PROVIDER=aws)
# OPENCRED_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/abcd-1234

# Azure Key Vault (when OPENCRED_KMS_PROVIDER=azure)
# OPENCRED_AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net
# OPENCRED_AZURE_KEY_NAME=issuer-signing-key

# GCP Cloud KMS (when OPENCRED_KMS_PROVIDER=gcp)
# OPENCRED_GCP_KMS_KEY_NAME=projects/my-project/locations/us-east1/keyRings/my-ring/cryptoKeys/issuer-key/cryptoKeyVersions/1
