{
  "name": "opencred",
  "version": "1.5.0",
  "private": true,
  "description": "W3C Verifiable Credential issuance and verification service",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml}\"",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "pkcs11js",
      "protobufjs"
    ],
    "overrides": {
      "@electron/rebuild@<3.7.2": "^3.7.2",
      "cacache@<20": "^20.0.4",
      "cross-spawn@<7.0.5": "^7.0.6",
      "fast-uri@<3.1.2": "^3.1.2",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "make-fetch-happen@<15": "^15.0.0",
      "flatted@<3.4.2": "^3.4.2",
      "glob@<10.5.0": "^10.5.0",
      "minimatch@<3.1.5": "^3.1.5",
      "minimatch@<9.0.9 >=9.0.0": "^9.0.9",
      "node-forge@<1.4.0": "^1.4.0",
      "node-gyp@<12": "^12.2.0",
      "picomatch@<4.0.4": "^4.0.4",
      "protobufjs@<7.5.6": "^7.5.6",
      "undici@<6.24.1": "^6.24.1"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
