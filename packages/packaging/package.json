{
  "name": "@opencred/packaging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/embed-fonts.cjs && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opencred/shared": "workspace:*",
    "@opencred/templates": "workspace:*",
    "@opencred/vc-core": "workspace:*",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
